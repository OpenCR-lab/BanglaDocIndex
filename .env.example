# Copy to .env and adjust. Every value here can also be set as an environment variable.

# Dataset root: the GCS bucket in production, or a local folder for development/tests.
DATA_URI=gs://bangla-ocr-dataset-v2
# Local scratch space (state, PDFs, renders, logs). One subfolder per source.
WORK_DIR=~/bocr-work

# Rendering (DESIGN.md 9.2): 150 DPI, never above a scan's own resolution, <= 8 MP.
RENDER_DPI=150
MAX_PAGE_PIXELS=8000000
JPEG_QUALITY=88
BATCH_PAGES=8
# Defaults to the machine's CPU count.
# RENDER_WORKERS=2
UPLOAD_WORKERS=4
# Concurrent source-item checks and PDF downloads (network bound).
DISCOVERY_WORKERS=8
DOWNLOAD_WORKERS=4

# Reliability
MAX_ATTEMPTS=5
CATALOG_FLUSH_DOCS=100
CHECKPOINT_INTERVAL_SECONDS=1800
PROGRESS_INTERVAL_SECONDS=30

# Disk backpressure for WORK_DIR
DISK_HIGH_WATER_GB=150
MIN_FREE_DISK_GB=20

# Document-level splits (the rest is train). Changing these changes split assignment.
SPLIT_VAL_FRACTION=0.05
SPLIT_TEST_FRACTION=0.05

USER_AGENT=bocr-scrape/0.1 (Bangla OCR dataset research)
